  "read_only_paths": ["MC1/", "MC1Services/", "MC1Tests/", "MC1Widgets/", "MeshCore/", "Shared/", "AppIcon.icon/", "LICENSE"],
  "pending_capabilities": [
    "Trusted default-branch deployment of WP-000",
    "Merged, evidenced and human-approved supervised WPs 000-003",
    "Configured required-check application/workflow identities and branch rules",
    "Cloud user-to-server authentication and repository/account assignability (read-only probe returned HTTP 404)",
    "Native Copilot app local-host adapter and isolated reviewer/check publisher",
    "Durable shared lease/merge ledger and complete backend usage measurements",
    "User-selected concurrency/usage limits and separate explicit activation",
    "Verified stable Java/Android SDK/AGP/Gradle environment from later scaffold WPs"
  ]
}
