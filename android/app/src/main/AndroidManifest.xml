<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidOnly: WP-002 Launcher; WP-303 registers the process Application. Radio, network and service declarations come from core:connectivity's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name="com.meshcoreone.android.app.MeshCoreApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/scaffold_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/l10n_locales"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshCoreOne">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
