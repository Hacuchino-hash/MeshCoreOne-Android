{
  "schema_version": 1,
  "repository": "cbattlegear/MeshCoreOne-Android",
  "default_branch": "main",
  "dispatch_mode": "off",
  "paused": true,
  "activation_approved": false,
  "foundation_required": ["WP-000", "WP-001", "WP-002", "WP-003"],
  "required_checks": ["android-ci", "parity-review", "gate-integrity"],
  "trusted_check_app_ids": [],
  "trusted_workflow_ids": [],
  "trusted_gate_publisher_app_id": null,
  "branch_rules_proven": false,
  "maintainers": ["cbattlegear"],
  "repair_limit": 3,
  "merge_strategy": "serialized-exact-head-current-base",
  "admin_bypass": false,
  "protected_paths": [
    ".github/",
    "tools/android-port/",
    "docs/android/PORTING_PLAN.md",
    "docs/android/AUTOMATION.md",
    "docs/android/port-manifest.json",
    "docs/android/port-manifest.schema.json",
    "docs/android/not-ported.json",
    "docs/android/not-ported.schema.json",
    "docs/android/automation-policy.json",
    "docs/android/adr/",
    "docs/android/architecture/",
    "docs/android/test-cases.json",
    "docs/android/golden-policy.json",
    "android/gradle/",
    "android/build-logic/",
    "android/core/database/",
    "android/core/testing/",
    "android/app/src/main/kotlin/com/meshcoreone/android/app/container/",
    "android/release/"
  ],
  "protected_patterns": [
    "android/*.gradle.kts",
    "android/**/build.gradle.kts",
    "android/**/AndroidManifest.xml",
    "android/**/AppContainer.kt",
    "android/**/RadioSessionContainer.kt",
    "android/**/schemas/*",
    "android/**/golden/*",
    "android/**/goldens/*",
    "android/**/fixtures/*",
    "android/**/proguard*",
    "android/**/gradle.properties",
    "android/**/gradle-wrapper.properties",
